{"charon_version":"0.1.279","translated":{"crate_name":"tls_core","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":["tls_core::schedule::record_count","tls_core::handshake::checked_handshake_total","tls_core::protected::inner_length","tls_core::protected::valid_content_type","tls_core::key_schedule::hkdf_label_encoded_len","tls_core::client_policy::client_phase_next"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/var/folders/d1/r2bpvclx19q4vd4c_8g42ddh0000gn/T/tlsed-translation-1e7tjqoh/tls_core.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"crates/tls-core/src/lib.rs"},"crate_name":"tls_core","contents":"//! Experimental TLS 1.3 foundations, not a TLS endpoint or secure channel.\n//!\n//! This library implements bounded wire/handshake framing, segmentation, counter\n//! bookkeeping, an abstract authentication model, and protected records through\n//! a maintained cryptographic provider. It does not perform a complete handshake\n//! or certificate verification and owns no transport. A linked arithmetic proof\n//! covers the functions named in the proof ledger under translation trust.\n//! Record authentication does not establish peer identity. No external security\n//! audit is claimed; an actual endpoint must enforce the authentication policy.\n#![no_std]\n\npub mod auth;\npub mod client_policy;\npub mod counter;\npub mod framing;\npub mod handshake;\npub mod hello;\npub mod key_schedule;\npub mod protected;\npub mod schedule;\npub mod transcript;\npub mod wire;\n\n/// Errors are explicit; malformed input never produces a successful frame.\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum Error {\n    InvalidLimit,\n    RecordOverflow,\n    UnexpectedType,\n    InvalidVersion,\n    InvalidLength,\n    BufferTooSmall,\n    Failed,\n    UnexpectedEvent,\n    Exhausted,\n    IncompleteRecord,\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"crates/tls-core/src/schedule.rs"},"crate_name":"tls_core","contents":"//! Capacity-respecting greedy segmentation, minimizing record count only.\nuse crate::Error;\n\n/// Minimum number of nonempty chunks of at most `capacity` for `bytes`.\n/// Avoids overflowing `bytes + capacity - 1`, even for `usize::MAX`.\n// Keep the executable arithmetic identical to the Lean/model contract.\n#[allow(clippy::manual_is_multiple_of)]\npub fn record_count(bytes: usize, capacity: usize) -> Result<usize, Error> {\n    if capacity == 0 {\n        return Err(Error::InvalidLimit);\n    }\n    Ok(bytes / capacity + usize::from(bytes % capacity != 0))\n}\n\n/// Allocation-free chunk lengths; no padding, latency or crypto cost model.\n#[derive(Debug)]\npub struct ChunkSchedule {\n    remaining: usize,\n    capacity: usize,\n}\n\nimpl ChunkSchedule {\n    pub fn new(bytes: usize, capacity: usize) -> Result<Self, Error> {\n        record_count(bytes, capacity)?;\n        Ok(Self {\n            remaining: bytes,\n            capacity,\n        })\n    }\n}\n\nimpl Iterator for ChunkSchedule {\n    type Item = usize;\n\n    fn next(&mut self) -> Option<usize> {\n        if self.remaining == 0 {\n            return None;\n        }\n        let length = self.remaining.min(self.capacity);\n        self.remaining -= length;\n        Some(length)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let count = self.remaining / self.capacity\n            + usize::from(!self.remaining.is_multiple_of(self.capacity));\n        (count, Some(count))\n    }\n}\n\nimpl ExactSizeIterator for ChunkSchedule {}\nimpl core::iter::FusedIterator for ChunkSchedule {}\n"},{"id":6,"name":{"Local":"crates/tls-core/src/handshake.rs"},"crate_name":"tls_core","contents":"//! Bounded syntactic handshake reassembly. The endpoint must supply actual\n//! record boundaries/key epochs and validate message bodies and ordering.\nuse zeroize::Zeroize;\n\npub const HANDSHAKE_HEADER_LEN: usize = 4;\npub const MAX_HANDSHAKE_BODY: usize = 0x00ff_ffff;\n\n/// Checked arithmetic shared with the Lean model and translated proof.\npub fn checked_handshake_total(body: usize, cap: usize) -> Option<usize> {\n    if body > MAX_HANDSHAKE_BODY || body > cap {\n        None\n    } else {\n        body.checked_add(HANDSHAKE_HEADER_LEN)\n    }\n}\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum HandshakeError {\n    InvalidLimit,\n    BufferTooSmall,\n    UnexpectedType,\n    MessageTooLarge,\n    EpochChanged,\n    MisalignedKeyChange,\n    InterleavedRecord,\n    IncompleteMessage,\n    Failed,\n}\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum Status {\n    NeedInput,\n    NeedWork,\n    MessageReady,\n}\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub struct Progress {\n    pub consumed: usize,\n    pub status: Status,\n}\n\n/// A syntactic message, not proof of certificate/Finished authenticity.\npub struct Message<'a> {\n    pub message_type: u8,\n    pub body: &'a [u8],\n    /// Exact handshake header plus body for eventual transcript hashing.\n    pub encoded: &'a [u8],\n}\n\nfn supported_type(kind: u8) -> bool {\n    // EndOfEarlyData is excluded because initial releases disable 0-RTT;\n    // message_hash is internal to HRR transcripts and never a wire message.\n    matches!(kind, 1 | 2 | 4 | 8 | 11 | 13 | 15 | 20 | 24)\n}\n\nfn requires_record_alignment(kind: u8) -> bool {\n    matches!(kind, 1 | 2 | 20 | 24)\n}\n\n/// One retained message, explicit consumption, caller storage, and bounded work.\n/// Network/framing errors poison the instance. Premature consumption is a\n/// recoverable caller error. Compatibility CCS is dropped by the endpoint before\n/// calling this component; other record types must use `note_other_record`.\npub struct Reassembler<'a> {\n    scratch: &'a mut [u8],\n    cap: usize,\n    work_budget: usize,\n    buffered: usize,\n    target: Option<usize>,\n    epoch: Option<u64>,\n    failed: bool,\n}\n\nimpl<'a> Reassembler<'a> {\n    pub fn new(\n        scratch: &'a mut [u8],\n        max_body: usize,\n        work_budget: usize,\n    ) -> Result<Self, HandshakeError> {\n        let maximum =\n            checked_handshake_total(max_body, max_body).ok_or(HandshakeError::InvalidLimit)?;\n        if work_budget == 0 {\n            return Err(HandshakeError::InvalidLimit);\n        }\n        if scratch.len() < maximum {\n            return Err(HandshakeError::BufferTooSmall);\n        }\n        Ok(Self {\n            scratch,\n            cap: max_body,\n            work_budget,\n            buffered: 0,\n            target: None,\n            epoch: None,\n            failed: false,\n        })\n    }\n\n    pub const fn buffered_len(&self) -> usize {\n        self.buffered\n    }\n\n    pub const fn is_failed(&self) -> bool {\n        self.failed\n    }\n\n    fn ready(&self) -> bool {\n        self.target == Some(self.buffered)\n    }\n\n    fn fail<T>(&mut self, error: HandshakeError) -> Result<T, HandshakeError> {\n        self.scratch[..self.buffered].zeroize();\n        self.failed = true;\n        Err(error)\n    }\n\n    /// `input` is a slice of one decoded Handshake record's remaining content.\n    /// `end_of_record` says that its final byte is the actual record boundary,\n    /// not a TCP/read/work boundary. Call again with the unconsumed tail after\n    /// NeedWork, or after processing and consuming a ready message.\n    pub fn push_fragment(\n        &mut self,\n        input: &[u8],\n        key_epoch: u64,\n        end_of_record: bool,\n    ) -> Result<Progress, HandshakeError> {\n        if self.failed {\n            return Err(HandshakeError::Failed);\n        }\n        if self.ready() {\n            return Ok(Progress {\n                consumed: 0,\n                status: Status::MessageReady,\n            });\n        }\n        if self.buffered != 0 && self.epoch != Some(key_epoch) {\n            return self.fail(HandshakeError::EpochChanged);\n        }\n        if self.buffered == 0 && !input.is_empty() {\n            self.epoch = Some(key_epoch);\n        }\n        let mut consumed = 0;\n        if self.target.is_none() {\n            let take = (HANDSHAKE_HEADER_LEN - self.buffered)\n                .min(input.len())\n                .min(self.work_budget);\n            self.scratch[self.buffered..self.buffered + take].copy_from_slice(&input[..take]);\n            self.buffered += take;\n            consumed += take;\n            if self.buffered == HANDSHAKE_HEADER_LEN {\n                if !supported_type(self.scratch[0]) {\n                    return self.fail(HandshakeError::UnexpectedType);\n                }\n                let body = (usize::from(self.scratch[1]) << 16)\n                    | (usize::from(self.scratch[2]) << 8)\n                    | usize::from(self.scratch[3]);\n                let Some(target) = checked_handshake_total(body, self.cap) else {\n                    return self.fail(HandshakeError::MessageTooLarge);\n                };\n                self.target = Some(target);\n            }\n        }\n        if let Some(target) = self.target {\n            let take = (target - self.buffered)\n                .min(input.len() - consumed)\n                .min(self.work_budget - consumed);\n            self.scratch[self.buffered..self.buffered + take]\n                .copy_from_slice(&input[consumed..consumed + take]);\n            self.buffered += take;\n            consumed += take;\n        }\n        if self.ready()\n            && requires_record_alignment(self.scratch[0])\n            && (!end_of_record || consumed != input.len())\n        {\n            return self.fail(HandshakeError::MisalignedKeyChange);\n        }\n        Ok(Progress {\n            consumed,\n            status: if self.ready() {\n                Status::MessageReady\n            } else if consumed < input.len() {\n                Status::NeedWork\n            } else {\n                Status::NeedInput\n            },\n        })\n    }\n\n    pub fn message(&self) -> Result<Option<Message<'_>>, HandshakeError> {\n        if self.failed {\n            return Err(HandshakeError::Failed);\n        }\n        if !self.ready() {\n            return Ok(None);\n        }\n        Ok(Some(Message {\n            message_type: self.scratch[0],\n            body: &self.scratch[HANDSHAKE_HEADER_LEN..self.buffered],\n            encoded: &self.scratch[..self.buffered],\n        }))\n    }\n\n    pub fn consume_message(&mut self) -> Result<(), HandshakeError> {\n        if self.failed {\n            return Err(HandshakeError::Failed);\n        }\n        if !self.ready() {\n            return Err(HandshakeError::IncompleteMessage);\n        }\n        self.scratch[..self.buffered].zeroize();\n        self.buffered = 0;\n        self.target = None;\n        self.epoch = None;\n        Ok(())\n    }\n\n    /// Prevent fragmented handshake interleaving; valid compatibility CCS is\n    /// ignored by the endpoint before this method is considered.\n    pub fn note_other_record(&mut self) -> Result<(), HandshakeError> {\n        if self.failed {\n            return Err(HandshakeError::Failed);\n        }\n        if self.buffered != 0 {\n            return self.fail(HandshakeError::InterleavedRecord);\n        }\n        Ok(())\n    }\n\n    /// All retained handshake bytes must be handled before changing traffic keys.\n    pub fn check_key_change(&mut self) -> Result<(), HandshakeError> {\n        if self.failed {\n            return Err(HandshakeError::Failed);\n        }\n        if self.buffered != 0 {\n            return self.fail(HandshakeError::EpochChanged);\n        }\n        Ok(())\n    }\n\n    /// A ready complete message may still be processed after EOF; a partial\n    /// message is rejected. Orderly TLS closure is an endpoint responsibility.\n    pub fn finish_input(&mut self) -> Result<(), HandshakeError> {\n        if self.failed {\n            return Err(HandshakeError::Failed);\n        }\n        if self.buffered != 0 && !self.ready() {\n            return self.fail(HandshakeError::IncompleteMessage);\n        }\n        Ok(())\n    }\n}\n\nimpl Drop for Reassembler<'_> {\n    fn drop(&mut self) {\n        // Clear the entire caller loan, including unused reassembly storage.\n        let (head, words, tail) = bytemuck::pod_align_to_mut::<u8, u128>(self.scratch);\n        head.zeroize();\n        words.zeroize();\n        tail.zeroize();\n    }\n}\n"},{"id":7,"name":{"Local":"crates/tls-core/src/protected.rs"},"crate_name":"tls_core","contents":"//! Caller-buffer TLS 1.3 AEAD record components (RFC 9846 §§5.2–5.5).\n//!\n//! These components authenticate records under caller-installed traffic keys;\n//! they do not authenticate peer identity, run a handshake, or handle KeyUpdate.\n//! An endpoint must dispatch permitted unencrypted CCS before calling `open`.\nuse crate::Error;\nuse crate::counter::{ReadCounter, WriteCounter};\nuse crate::wire::{HEADER_LEN, Limits, MAX_PLAINTEXT, Parse, RecordKind, parse_record};\nuse tls_crypto::{AeadKey, CryptoError, NONCE_LEN, TAG_LEN};\nuse zeroize::Zeroize;\n\npub const MAX_INNER_PLAINTEXT: usize = MAX_PLAINTEXT + 1;\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n#[repr(u8)]\npub enum ContentType {\n    Alert = 21,\n    Handshake = 22,\n    ApplicationData = 23,\n}\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum ProtectedError {\n    Wire(Error),\n    Crypto(CryptoError),\n    InvalidInner,\n    InvalidLimit,\n    ProviderLength,\n    Exhausted,\n    Failed,\n    BufferTooSmall,\n}\n\n/// Pure size guard. The cap includes the inner type byte and zero padding.\n/// Negotiation of RFC 8449 record_size_limit remains an endpoint responsibility.\n// Explicit matches keep Aeneas extraction free of unsupported Option Try calls.\n#[allow(clippy::question_mark)]\npub fn inner_length(content_len: usize, padding_len: usize, inner_limit: usize) -> Option<usize> {\n    if inner_limit == 0 || inner_limit > MAX_INNER_PLAINTEXT {\n        return None;\n    }\n    let Some(with_type) = content_len.checked_add(1) else {\n        return None;\n    };\n    let Some(length) = with_type.checked_add(padding_len) else {\n        return None;\n    };\n    if length > inner_limit {\n        None\n    } else {\n        Some(length)\n    }\n}\n\n/// Allowed protected content and structural content lengths. This guard does\n/// not authenticate a byte string or validate message bodies/handshake states.\npub fn valid_content_type(content_type: u8, content_len: usize) -> bool {\n    match content_type {\n        21 => content_len == 2,\n        22 => content_len != 0,\n        23 => true,\n        _ => false,\n    }\n}\n\nfn validate_limit(limit: usize) -> Result<(), ProtectedError> {\n    if limit == 0 || limit > MAX_INNER_PLAINTEXT {\n        Err(ProtectedError::InvalidLimit)\n    } else {\n        Ok(())\n    }\n}\n\nfn nonce_for(iv: &[u8; NONCE_LEN], sequence: u64) -> [u8; NONCE_LEN] {\n    let mut nonce = *iv;\n    for (byte, sequence_byte) in nonce[4..].iter_mut().zip(sequence.to_be_bytes()) {\n        *byte ^= sequence_byte;\n    }\n    nonce\n}\n\n/// Erase caller bytes with aligned u128 stores, as `Reassembler::drop` does.\nfn wipe(bytes: &mut [u8]) {\n    let (head, words, tail) = bytemuck::pod_align_to_mut::<u8, u128>(bytes);\n    head.zeroize();\n    words.zeroize();\n    tail.zeroize();\n}\n\n/// Index of the last nonzero byte. Zero blocks are skipped from the end, so long\n/// padding costs one comparison per block. Same result as `rposition(|&b| b != 0)`.\nconst SCAN_BLOCK: usize = 64;\n\nfn last_nonzero(bytes: &[u8]) -> Option<usize> {\n    let mut end = bytes.len();\n    while end >= SCAN_BLOCK && bytes[end - SCAN_BLOCK..end] == [0u8; SCAN_BLOCK] {\n        end -= SCAN_BLOCK;\n    }\n    bytes[..end].iter().rposition(|&byte| byte != 0)\n}\n\nfn decode_inner(inner: &[u8], limit: usize) -> Result<(ContentType, usize), ProtectedError> {\n    if inner.is_empty() || inner.len() > limit {\n        return Err(ProtectedError::InvalidInner);\n    }\n    let index = last_nonzero(inner).ok_or(ProtectedError::InvalidInner)?;\n    if !valid_content_type(inner[index], index) {\n        return Err(ProtectedError::InvalidInner);\n    }\n    let content_type = match inner[index] {\n        21 => ContentType::Alert,\n        22 => ContentType::Handshake,\n        23 => ContentType::ApplicationData,\n        _ => return Err(ProtectedError::InvalidInner),\n    };\n    Ok((content_type, index))\n}\n\n/// Connection-owned sending traffic key and IV; neither Clone nor Debug.\n/// Caller buffer shortages and invalid local content do not consume a nonce.\n/// Crypto failure, provider contract violation and exhausted keys are terminal;\n/// they immediately drop the owned key and erase the static IV.\n/// Reserved nonces are retired before calling the provider, even on failure.\n/// Fresh key installation/rotation is deliberately not exposed in this milestone.\n/// Choose a stricter record cap if needed; never above the suite's sending cap.\npub struct ProtectedWriter<K: AeadKey> {\n    key: Option<K>,\n    iv: [u8; NONCE_LEN],\n    counter: WriteCounter,\n    inner_limit: usize,\n    failed: bool,\n}\n\nimpl<K: AeadKey> ProtectedWriter<K> {\n    pub fn new(\n        key: K,\n        mut iv: [u8; NONCE_LEN],\n        inner_limit: usize,\n        record_limit: u64,\n    ) -> Result<Self, ProtectedError> {\n        if validate_limit(inner_limit).is_err()\n            || record_limit == 0\n            || record_limit > key.suite().sending_record_limit()\n        {\n            iv.zeroize();\n            return Err(ProtectedError::InvalidLimit);\n        }\n        let counter = WriteCounter::new(record_limit).map_err(ProtectedError::Wire)?;\n        Ok(Self {\n            key: Some(key),\n            iv,\n            counter,\n            inner_limit,\n            failed: false,\n        })\n    }\n\n    pub const fn next_sequence(&self) -> u64 {\n        self.counter.next_sequence()\n    }\n    pub const fn is_failed(&self) -> bool {\n        self.failed\n    }\n\n    fn fail<T>(&mut self, output: &mut [u8], error: ProtectedError) -> Result<T, ProtectedError> {\n        self.failed = true;\n        wipe(output);\n        self.iv.zeroize();\n        drop(self.key.take());\n        Err(error)\n    }\n\n    /// Serialize and protect exactly one record. Output tail after the returned\n    /// wire length is untouched on success; terminal errors wipe all output.\n    /// Preflight errors leave output and sequence untouched. Padding is zeroed.\n    pub fn seal(\n        &mut self,\n        content_type: ContentType,\n        content: &[u8],\n        padding: usize,\n        output: &mut [u8],\n    ) -> Result<usize, ProtectedError> {\n        if self.failed {\n            return self.fail(output, ProtectedError::Failed);\n        }\n        if !valid_content_type(content_type as u8, content.len()) {\n            return Err(ProtectedError::InvalidInner);\n        }\n        let inner_len = inner_length(content.len(), padding, self.inner_limit)\n            .ok_or(ProtectedError::InvalidInner)?;\n        let cipher_len = inner_len + TAG_LEN; // bounded by 16,385 + fixed tag\n        let wire_len = HEADER_LEN + cipher_len;\n        if output.len() < wire_len {\n            return Err(ProtectedError::BufferTooSmall);\n        }\n        let reservation = match self.counter.reserve() {\n            Ok(value) => value,\n            Err(_) => {\n                return self.fail(output, ProtectedError::Exhausted);\n            }\n        };\n        let mut nonce = nonce_for(&self.iv, reservation.sequence());\n        let mut aad = [0; HEADER_LEN];\n        aad[0] = 23;\n        aad[1..3].copy_from_slice(&0x0303_u16.to_be_bytes());\n        aad[3..].copy_from_slice(&(cipher_len as u16).to_be_bytes());\n        output[..HEADER_LEN].copy_from_slice(&aad);\n        let body = &mut output[HEADER_LEN..wire_len];\n        body[..content.len()].copy_from_slice(content);\n        body[content.len()] = content_type as u8;\n        body[content.len() + 1..].fill(0);\n        let result = match self.key.as_ref() {\n            Some(key) => key.seal_in_place(&nonce, &aad, body, inner_len),\n            None => Err(CryptoError::BackendFailure),\n        };\n        nonce.zeroize();\n        let error = match result {\n            Ok(length) if length == cipher_len => return Ok(wire_len),\n            Ok(_) => ProtectedError::ProviderLength,\n            Err(error) => ProtectedError::Crypto(error),\n        };\n        self.fail(output, error)\n    }\n}\n\nimpl<K: AeadKey> Drop for ProtectedWriter<K> {\n    fn drop(&mut self) {\n        self.iv.zeroize();\n    }\n}\n\n/// Successfully authenticated and structurally validated inner content.\n/// This is authentication under the supplied key, not verified server identity;\n/// a real endpoint must still apply handshake/authentication release policy.\n/// No Debug formatter is provided for the plaintext.\npub struct OpenedRecord<'a> {\n    pub content_type: ContentType,\n    pub content: &'a [u8],\n}\n\n/// Separately owned receiving key/IV. No sending-specific GCM usage limit is\n/// imposed on receiving. Counters conservatively stop before sequence wrap.\n/// Invalid wire, failed AEAD, invalid inner content and exhaustion are terminal;\n/// terminal errors drop the owned key, erase its IV and wipe the entire supplied\n/// plaintext buffer. Partial input and\n/// output shortages do not reserve a nonce. No rotation/reset API is exposed.\npub struct ProtectedReader<K: AeadKey> {\n    key: Option<K>,\n    iv: [u8; NONCE_LEN],\n    counter: ReadCounter,\n    inner_limit: usize,\n    failed: bool,\n}\n\nimpl<K: AeadKey> ProtectedReader<K> {\n    pub fn new(\n        key: K,\n        mut iv: [u8; NONCE_LEN],\n        inner_limit: usize,\n    ) -> Result<Self, ProtectedError> {\n        if validate_limit(inner_limit).is_err() {\n            iv.zeroize();\n            return Err(ProtectedError::InvalidLimit);\n        }\n        let counter = ReadCounter::new(u64::MAX).map_err(ProtectedError::Wire)?;\n        Ok(Self {\n            key: Some(key),\n            iv,\n            counter,\n            inner_limit,\n            failed: false,\n        })\n    }\n\n    pub const fn next_sequence(&self) -> u64 {\n        self.counter.next_sequence()\n    }\n    pub const fn is_failed(&self) -> bool {\n        self.failed\n    }\n\n    fn fail<T>(&mut self, output: &mut [u8], error: ProtectedError) -> Result<T, ProtectedError> {\n        self.failed = true;\n        wipe(output);\n        self.iv.zeroize();\n        drop(self.key.take());\n        Err(error)\n    }\n\n    /// Open the first complete wire record; report its consumed length so the\n    /// caller can retain coalesced trailing records. Copy ciphertext into caller\n    /// storage, then authenticate in place. No borrowed content is returned\n    /// until AEAD and all inner checks succeed. Incomplete input is untouched.\n    pub fn open<'a>(\n        &mut self,\n        input: &[u8],\n        output: &'a mut [u8],\n    ) -> Result<Parse<OpenedRecord<'a>>, ProtectedError> {\n        if self.failed {\n            return self.fail(output, ProtectedError::Failed);\n        }\n        let limits = Limits::new(RecordKind::Ciphertext, self.inner_limit + TAG_LEN)\n            .map_err(ProtectedError::Wire)?;\n        let (record, consumed) = match parse_record(input, limits) {\n            Ok(Parse::Incomplete { needed }) => return Ok(Parse::Incomplete { needed }),\n            Ok(Parse::Complete { value, consumed }) => (value, consumed),\n            Err(error) => return self.fail(output, ProtectedError::Wire(error)),\n        };\n        if record.payload.len() <= TAG_LEN {\n            return self.fail(output, ProtectedError::InvalidInner);\n        }\n        if output.len() < record.payload.len() {\n            return Err(ProtectedError::BufferTooSmall);\n        }\n        let reservation = match self.counter.reserve() {\n            Ok(value) => value,\n            Err(_) => return self.fail(output, ProtectedError::Exhausted),\n        };\n        let mut nonce = nonce_for(&self.iv, reservation.sequence());\n        let cipher_len = record.payload.len();\n        output[..cipher_len].copy_from_slice(record.payload);\n        let result = match self.key.as_ref() {\n            Some(key) => key.open_in_place(&nonce, &input[..HEADER_LEN], &mut output[..cipher_len]),\n            None => Err(CryptoError::BackendFailure),\n        };\n        nonce.zeroize();\n        let inner_len = match result {\n            Ok(length) if length == cipher_len - TAG_LEN => length,\n            Ok(_) => return self.fail(output, ProtectedError::ProviderLength),\n            Err(error) => return self.fail(output, ProtectedError::Crypto(error)),\n        };\n        let (content_type, content_len) = match decode_inner(&output[..inner_len], self.inner_limit)\n        {\n            Ok(value) => value,\n            Err(error) => return self.fail(output, error),\n        };\n        // Erase type, padding, decrypted trailing tag, and unused caller scratch.\n        wipe(&mut output[content_len..]);\n        Ok(Parse::Complete {\n            value: OpenedRecord {\n                content_type,\n                content: &output[..content_len],\n            },\n            consumed,\n        })\n    }\n}\n\nimpl<K: AeadKey> Drop for ProtectedReader<K> {\n    fn drop(&mut self) {\n        self.iv.zeroize();\n    }\n}\n\n#[cfg(test)]\nmod equivalence {\n    use super::*;\n\n    #[test]\n    fn wipe_zeroes_exact_range() {\n        for offset in 0..32 {\n            for size in (0..=257).chain([1_023, 1_024, 1_025, 16_383, 16_384, 16_385]) {\n                let start = 16 + offset;\n                let mut data = [0xa5u8; 16_512];\n                let mut expected = [0xa5u8; 16_512];\n                expected[start..start + size].fill(0);\n                wipe(&mut data[start..start + size]);\n                assert!(data == expected, \"size={size} offset={offset}\");\n            }\n        }\n    }\n\n    #[test]\n    fn last_nonzero_matches_rposition() {\n        let mut state = 0x9E37_79B9_7F4A_7C15_u64;\n        let mut next = move || {\n            state ^= state << 13;\n            state ^= state >> 7;\n            state ^= state << 17;\n            state\n        };\n        let mut bytes = [0u8; 16_385];\n        for len in (0..=300).chain([1_023, 1_024, 4_095, 16_383, 16_384, 16_385]) {\n            assert_eq!(last_nonzero(&bytes[..len]), None, \"zeros len={len}\");\n            let step = if len <= 300 { 1 } else { 97 };\n            for pos in (0..len).step_by(step) {\n                bytes[pos] = 1;\n                assert_eq!(\n                    last_nonzero(&bytes[..len]),\n                    bytes[..len].iter().rposition(|&b| b != 0),\n                    \"single len={len} pos={pos}\"\n                );\n                bytes[pos] = 0;\n            }\n            for _ in 0..64 {\n                bytes[..len].fill(0);\n                if len > 0 {\n                    for _ in 0..(next() % 8) {\n                        let pos = (next() as usize) % len;\n                        bytes[pos] = (next() as u8) | 1;\n                    }\n                }\n                assert_eq!(\n                    last_nonzero(&bytes[..len]),\n                    bytes[..len].iter().rposition(|&b| b != 0),\n                    \"random len={len}\"\n                );\n            }\n            bytes[..len].fill(0);\n        }\n    }\n}\n"},{"id":8,"name":{"Local":"crates/tls-core/src/key_schedule.rs"},"crate_name":"tls_core","contents":"//! TLS 1.3 no-PSK key schedule orchestration over a maintained provider.\n//! Caller transcript binding, authentic fresh shared secrets, release policy,\n//! old-key KeyUpdate ordering and atomic record-key installation remain trusted\n//! endpoint responsibilities. This module performs no handshake or identity check.\nuse crate::counter::MAX_SEND_EPOCH;\nuse core::marker::PhantomData;\nuse tls_crypto::{\n    CipherSuite, CryptoError, CryptoProvider, HandshakeCryptoProvider, HashAlgorithm, NONCE_LEN,\n};\nuse zeroize::Zeroize;\n\npub const MAX_SECRET_LEN: usize = 48;\npub const MAX_HKDF_LABEL: usize = 514;\npub const MAX_SHARED_SECRET: usize = 256;\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum KeyScheduleError {\n    InvalidLabel,\n    InvalidHashLength,\n    InvalidSharedSecret,\n    BufferTooSmall,\n    UnsupportedSuite,\n    EpochExhausted,\n    Crypto(CryptoError),\n}\n\n/// Exact TLS HKDF label size; guards make both additions native-overflow safe.\npub fn hkdf_label_encoded_len(\n    output_len: usize,\n    label_len: usize,\n    context_len: usize,\n) -> Option<usize> {\n    if output_len > 65535 || label_len == 0 || label_len > 249 || context_len > 255 {\n        None\n    } else {\n        Some(10 + label_len + context_len)\n    }\n}\n\n/// Encode TLS HkdfLabel into caller storage. On error erase supplied output;\n/// success leaves its tail untouched. The six-byte TLS prefix is mandatory.\npub fn encode_hkdf_label(\n    output_len: usize,\n    label: &[u8],\n    context: &[u8],\n    output: &mut [u8],\n) -> Result<usize, KeyScheduleError> {\n    let Some(length) = hkdf_label_encoded_len(output_len, label.len(), context.len()) else {\n        output.zeroize();\n        return Err(KeyScheduleError::InvalidLabel);\n    };\n    if output.len() < length {\n        output.zeroize();\n        return Err(KeyScheduleError::BufferTooSmall);\n    }\n    output[..2].copy_from_slice(&(output_len as u16).to_be_bytes());\n    output[2] = (6 + label.len()) as u8;\n    output[3..9].copy_from_slice(b\"tls13 \");\n    output[9..9 + label.len()].copy_from_slice(label);\n    output[9 + label.len()] = context.len() as u8;\n    output[10 + label.len()..length].copy_from_slice(context);\n    Ok(length)\n}\n\n/// HKDF-Expand-Label. PRKs have exactly the selected hash length; failed\n/// preflight/provider calls erase the entire caller's secret output.\npub fn expand_label<P: CryptoProvider>(\n    provider: &P,\n    algorithm: HashAlgorithm,\n    secret: &[u8],\n    label: &[u8],\n    context: &[u8],\n    output: &mut [u8],\n) -> Result<(), KeyScheduleError> {\n    if secret.len() != algorithm.output_len() {\n        output.zeroize();\n        return Err(KeyScheduleError::InvalidHashLength);\n    }\n    let mut info = [0; MAX_HKDF_LABEL];\n    let length = match encode_hkdf_label(output.len(), label, context, &mut info) {\n        Ok(length) => length,\n        Err(error) => {\n            output.zeroize();\n            return Err(error);\n        }\n    };\n    let result = provider.hkdf_expand(algorithm, secret, &info[..length], output);\n    info.zeroize();\n    match result {\n        Ok(()) => Ok(()),\n        Err(error) => {\n            output.zeroize();\n            Err(KeyScheduleError::Crypto(error))\n        }\n    }\n}\n\n/// Owned secret with bounded storage; intentionally neither Debug nor Clone.\n/// Explicit byte access can expose secrets: callers must not log or retain copies.\n/// Drop erases this owner's entire buffer, not compiler/provider/caller copies.\n///\n/// ```compile_fail\n/// use tls_core::key_schedule::BoundedSecret;\n/// fn duplicate(secret: BoundedSecret) { let copy = secret.clone(); }\n/// ```\n/// ```compile_fail\n/// use tls_core::key_schedule::BoundedSecret;\n/// fn log(secret: BoundedSecret) { println!(\"{secret:?}\"); }\n/// ```\npub struct BoundedSecret {\n    bytes: [u8; MAX_SECRET_LEN],\n    len: usize,\n}\nimpl BoundedSecret {\n    fn zeroed(len: usize) -> Self {\n        Self {\n            bytes: [0; MAX_SECRET_LEN],\n            len,\n        }\n    }\n    pub fn as_bytes(&self) -> &[u8] {\n        &self.bytes[..self.len]\n    }\n    fn as_mut_bytes(&mut self) -> &mut [u8] {\n        &mut self.bytes[..self.len]\n    }\n}\nimpl Drop for BoundedSecret {\n    fn drop(&mut self) {\n        self.bytes.zeroize();\n        self.len = 0;\n    }\n}\n\nfn hash_empty<P: CryptoProvider>(\n    provider: &P,\n    algorithm: HashAlgorithm,\n) -> Result<BoundedSecret, KeyScheduleError> {\n    let mut hash = BoundedSecret::zeroed(algorithm.output_len());\n    provider\n        .hash(algorithm, b\"\", hash.as_mut_bytes())\n        .map_err(KeyScheduleError::Crypto)?;\n    Ok(hash)\n}\nfn extract<P: CryptoProvider>(\n    provider: &P,\n    algorithm: HashAlgorithm,\n    salt: &[u8],\n    input: &[u8],\n) -> Result<BoundedSecret, KeyScheduleError> {\n    let mut secret = BoundedSecret::zeroed(algorithm.output_len());\n    provider\n        .hkdf_extract(algorithm, salt, input, secret.as_mut_bytes())\n        .map_err(KeyScheduleError::Crypto)?;\n    Ok(secret)\n}\nfn derive<P: CryptoProvider>(\n    provider: &P,\n    algorithm: HashAlgorithm,\n    secret: &[u8],\n    label: &[u8],\n    hash: &[u8],\n) -> Result<BoundedSecret, KeyScheduleError> {\n    if hash.len() != algorithm.output_len() {\n        return Err(KeyScheduleError::InvalidHashLength);\n    }\n    let mut output = BoundedSecret::zeroed(algorithm.output_len());\n    expand_label(\n        provider,\n        algorithm,\n        secret,\n        label,\n        hash,\n        output.as_mut_bytes(),\n    )?;\n    Ok(output)\n}\n\npub struct Client;\npub struct Server;\npub struct Handshake;\npub struct Application;\n\n/// Origin direction and key stage are static types; construction is private.\n/// Neither Clone nor Debug. Raw transcript hashes must correspond to the exact\n/// caller's authenticated message ordering, including HRR rewriting.\n///\n/// ```compile_fail\n/// use tls_core::key_schedule::{Client, Server, Handshake, TrafficSecret};\n/// fn server_secret(_: TrafficSecret<Server, Handshake>) {}\n/// fn wrong_direction(secret: TrafficSecret<Client, Handshake>) { server_secret(secret); }\n/// ```\n/// ```compile_fail\n/// use tls_core::key_schedule::{Client, Application, TrafficSecret};\n/// use tls_crypto_awslc::AwsLcProvider;\n/// fn wrong_stage(secret: TrafficSecret<Client, Application>) {\n///     secret.sign_finished(&AwsLcProvider, &[0;32], &mut [0;32]);\n/// }\n/// ```\npub struct TrafficSecret<D, S> {\n    secret: BoundedSecret,\n    suite: CipherSuite,\n    epoch: u64,\n    marker: PhantomData<(D, S)>,\n}\nimpl<D, S> TrafficSecret<D, S> {\n    fn new(secret: BoundedSecret, suite: CipherSuite, epoch: u64) -> Self {\n        Self {\n            secret,\n            suite,\n            epoch,\n            marker: PhantomData,\n        }\n    }\n    pub const fn suite(&self) -> CipherSuite {\n        self.suite\n    }\n    pub const fn epoch(&self) -> u64 {\n        self.epoch\n    }\n    /// Derivation is deterministic, not evidence of a freshly installed key.\n    /// Never reset a record counter by reimporting this same key/IV pair.\n    pub fn key_material<P: CryptoProvider>(\n        &self,\n        provider: &P,\n    ) -> Result<TrafficKeyMaterial<D, S>, KeyScheduleError> {\n        let mut key = BoundedSecret::zeroed(self.suite.key_len());\n        expand_label(\n            provider,\n            self.suite.hash(),\n            self.secret.as_bytes(),\n            b\"key\",\n            b\"\",\n            key.as_mut_bytes(),\n        )?;\n        let mut iv = BoundedSecret::zeroed(NONCE_LEN);\n        expand_label(\n            provider,\n            self.suite.hash(),\n            self.secret.as_bytes(),\n            b\"iv\",\n            b\"\",\n            iv.as_mut_bytes(),\n        )?;\n        Ok(TrafficKeyMaterial {\n            key,\n            iv,\n            suite: self.suite,\n            epoch: self.epoch,\n            marker: PhantomData,\n        })\n    }\n}\n\n/// Direction/stage-specific key and IV bytes, erased on drop. Explicit raw\n/// access supports provider import; no automatic installation/reset is performed.\npub struct TrafficKeyMaterial<D, S> {\n    key: BoundedSecret,\n    iv: BoundedSecret,\n    suite: CipherSuite,\n    epoch: u64,\n    marker: PhantomData<(D, S)>,\n}\nimpl<D, S> TrafficKeyMaterial<D, S> {\n    pub fn key_bytes(&self) -> &[u8] {\n        self.key.as_bytes()\n    }\n    pub fn iv_bytes(&self) -> &[u8] {\n        self.iv.as_bytes()\n    }\n    pub const fn suite(&self) -> CipherSuite {\n        self.suite\n    }\n    pub const fn epoch(&self) -> u64 {\n        self.epoch\n    }\n}\n\nimpl<D> TrafficSecret<D, Handshake> {\n    fn finished_key<P: CryptoProvider>(\n        &self,\n        provider: &P,\n    ) -> Result<BoundedSecret, KeyScheduleError> {\n        let mut key = BoundedSecret::zeroed(self.suite.hash().output_len());\n        expand_label(\n            provider,\n            self.suite.hash(),\n            self.secret.as_bytes(),\n            b\"finished\",\n            b\"\",\n            key.as_mut_bytes(),\n        )?;\n        Ok(key)\n    }\n    /// Generate Finished over the caller's pre-Finished transcript hash. Returned\n    /// errors erase output. This does not advance or authenticate an endpoint.\n    pub fn sign_finished<P: HandshakeCryptoProvider>(\n        &self,\n        provider: &P,\n        transcript_hash: &[u8],\n        output: &mut [u8],\n    ) -> Result<(), KeyScheduleError> {\n        let algorithm = self.suite.hash();\n        if transcript_hash.len() != algorithm.output_len() || output.len() != algorithm.output_len()\n        {\n            output.zeroize();\n            return Err(KeyScheduleError::InvalidHashLength);\n        }\n        let key = match self.finished_key(provider) {\n            Ok(key) => key,\n            Err(error) => {\n                output.zeroize();\n                return Err(error);\n            }\n        };\n        match provider.hmac_sign(algorithm, key.as_bytes(), transcript_hash, output) {\n            Ok(()) => Ok(()),\n            Err(error) => {\n                output.zeroize();\n                Err(KeyScheduleError::Crypto(error))\n            }\n        }\n    }\n    /// Provider authentication API performs tag comparison. A real endpoint\n    /// must terminate and retire its owners on failure; this borrowed low-level\n    /// operation returns no authentication status or state advancement.\n    pub fn verify_finished<P: HandshakeCryptoProvider>(\n        &self,\n        provider: &P,\n        transcript_hash: &[u8],\n        tag: &[u8],\n    ) -> Result<(), KeyScheduleError> {\n        let algorithm = self.suite.hash();\n        if transcript_hash.len() != algorithm.output_len() || tag.len() != algorithm.output_len() {\n            return Err(KeyScheduleError::InvalidHashLength);\n        }\n        let key = self.finished_key(provider)?;\n        provider\n            .hmac_verify(algorithm, key.as_bytes(), transcript_hash, tag)\n            .map_err(KeyScheduleError::Crypto)\n    }\n}\n\n/// No-PSK handshake derivation. Ephemeral shared-secret validity/freshness and\n/// CH-through-SH transcript authenticity are caller/provider responsibilities.\npub struct HandshakeSecrets {\n    handshake: BoundedSecret,\n    suite: CipherSuite,\n    pub client: TrafficSecret<Client, Handshake>,\n    pub server: TrafficSecret<Server, Handshake>,\n}\nimpl HandshakeSecrets {\n    pub fn derive<P: CryptoProvider>(\n        provider: &P,\n        suite: CipherSuite,\n        shared_secret: &[u8],\n        hello_hash: &[u8],\n    ) -> Result<Self, KeyScheduleError> {\n        if !provider.supports(suite) {\n            return Err(KeyScheduleError::UnsupportedSuite);\n        }\n        if shared_secret.is_empty() || shared_secret.len() > MAX_SHARED_SECRET {\n            return Err(KeyScheduleError::InvalidSharedSecret);\n        }\n        let algorithm = suite.hash();\n        if hello_hash.len() != algorithm.output_len() {\n            return Err(KeyScheduleError::InvalidHashLength);\n        }\n        let zeros = BoundedSecret::zeroed(algorithm.output_len());\n        let early = extract(provider, algorithm, zeros.as_bytes(), zeros.as_bytes())?;\n        let empty_hash = hash_empty(provider, algorithm)?;\n        let derived = derive(\n            provider,\n            algorithm,\n            early.as_bytes(),\n            b\"derived\",\n            empty_hash.as_bytes(),\n        )?;\n        let handshake = extract(provider, algorithm, derived.as_bytes(), shared_secret)?;\n        let client = TrafficSecret::new(\n            derive(\n                provider,\n                algorithm,\n                handshake.as_bytes(),\n                b\"c hs traffic\",\n                hello_hash,\n            )?,\n            suite,\n            0,\n        );\n        let server = TrafficSecret::new(\n            derive(\n                provider,\n                algorithm,\n                handshake.as_bytes(),\n                b\"s hs traffic\",\n                hello_hash,\n            )?,\n            suite,\n            0,\n        );\n        Ok(Self {\n            handshake,\n            suite,\n            client,\n            server,\n        })\n    }\n    /// Consume the base handshake secret, deriving no-PSK main/application and\n    /// exporter secrets at the server-Finished transcript boundary. Handshake\n    /// traffic owners are returned for client Finished/protected handshake use;\n    /// the endpoint must explicitly retire them once no longer needed.\n    pub fn into_application<P: CryptoProvider>(\n        self,\n        provider: &P,\n        server_finished_hash: &[u8],\n    ) -> Result<ApplicationTransition, KeyScheduleError> {\n        let algorithm = self.suite.hash();\n        if server_finished_hash.len() != algorithm.output_len() {\n            return Err(KeyScheduleError::InvalidHashLength);\n        }\n        let empty_hash = hash_empty(provider, algorithm)?;\n        let derived = derive(\n            provider,\n            algorithm,\n            self.handshake.as_bytes(),\n            b\"derived\",\n            empty_hash.as_bytes(),\n        )?;\n        let zeros = BoundedSecret::zeroed(algorithm.output_len());\n        let main = extract(provider, algorithm, derived.as_bytes(), zeros.as_bytes())?;\n        let client = TrafficSecret::new(\n            derive(\n                provider,\n                algorithm,\n                main.as_bytes(),\n                b\"c ap traffic\",\n                server_finished_hash,\n            )?,\n            self.suite,\n            0,\n        );\n        let server = TrafficSecret::new(\n            derive(\n                provider,\n                algorithm,\n                main.as_bytes(),\n                b\"s ap traffic\",\n                server_finished_hash,\n            )?,\n            self.suite,\n            0,\n        );\n        let exporter = derive(\n            provider,\n            algorithm,\n            main.as_bytes(),\n            b\"exp master\",\n            server_finished_hash,\n        )?;\n        Ok(ApplicationTransition {\n            client_handshake: self.client,\n            server_handshake: self.server,\n            application: ApplicationSecrets {\n                client,\n                server,\n                exporter,\n            },\n        })\n    }\n}\npub struct ApplicationTransition {\n    pub client_handshake: TrafficSecret<Client, Handshake>,\n    pub server_handshake: TrafficSecret<Server, Handshake>,\n    pub application: ApplicationSecrets,\n}\npub struct ApplicationSecrets {\n    pub client: TrafficSecret<Client, Application>,\n    pub server: TrafficSecret<Server, Application>,\n    /// Retained for future exporter orchestration; no exporter API is provided.\n    pub exporter: BoundedSecret,\n}\n\nimpl<D> TrafficSecret<D, Application> {\n    pub fn into_sending(self) -> SendingTraffic<D> {\n        SendingTraffic(self)\n    }\n    pub fn into_receiving(self) -> ReceivingTraffic<D> {\n        ReceivingTraffic(self)\n    }\n    fn update<P: CryptoProvider>(\n        self,\n        provider: &P,\n        maximum: u64,\n    ) -> Result<Self, KeyScheduleError> {\n        if self.epoch >= maximum {\n            return Err(KeyScheduleError::EpochExhausted);\n        }\n        let Some(epoch) = self.epoch.checked_add(1) else {\n            return Err(KeyScheduleError::EpochExhausted);\n        };\n        let mut secret = BoundedSecret::zeroed(self.suite.hash().output_len());\n        expand_label(\n            provider,\n            self.suite.hash(),\n            self.secret.as_bytes(),\n            b\"traffic upd\",\n            b\"\",\n            secret.as_mut_bytes(),\n        )?;\n        Ok(Self::new(secret, self.suite, epoch))\n    }\n}\n/// Application traffic owner selected for local sending; consumes the old secret\n/// on update. Old-key KeyUpdate emission must precede record-key installation.\n///\n/// ```compile_fail\n/// use tls_core::key_schedule::{Client, SendingTraffic};\n/// use tls_crypto_awslc::AwsLcProvider;\n/// fn reuse_after_update(secret: SendingTraffic<Client>) {\n///     let updated = secret.update(&AwsLcProvider);\n///     let old_epoch = secret.epoch();\n/// }\n/// ```\npub struct SendingTraffic<D>(TrafficSecret<D, Application>);\nimpl<D> SendingTraffic<D> {\n    pub const fn epoch(&self) -> u64 {\n        self.0.epoch\n    }\n    pub fn key_material<P: CryptoProvider>(\n        &self,\n        provider: &P,\n    ) -> Result<TrafficKeyMaterial<D, Application>, KeyScheduleError> {\n        self.0.key_material(provider)\n    }\n    pub fn update<P: CryptoProvider>(self, provider: &P) -> Result<Self, KeyScheduleError> {\n        Ok(Self(self.0.update(provider, MAX_SEND_EPOCH)?))\n    }\n}\n/// Receiving application owner does not enforce the sending epoch cap. Actual\n/// authenticated old-key KeyUpdate acceptance is an endpoint responsibility.\npub struct ReceivingTraffic<D>(TrafficSecret<D, Application>);\nimpl<D> ReceivingTraffic<D> {\n    pub const fn epoch(&self) -> u64 {\n        self.0.epoch\n    }\n    pub fn key_material<P: CryptoProvider>(\n        &self,\n        provider: &P,\n    ) -> Result<TrafficKeyMaterial<D, Application>, KeyScheduleError> {\n        self.0.key_material(provider)\n    }\n    pub fn update<P: CryptoProvider>(self, provider: &P) -> Result<Self, KeyScheduleError> {\n        Ok(Self(self.0.update(provider, u64::MAX)?))\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use tls_crypto_awslc::AwsLcProvider;\n\n    fn at_epoch(epoch: u64) -> TrafficSecret<Client, Application> {\n        let mut secret = BoundedSecret::zeroed(32);\n        secret.bytes[..32].fill(0x37); // isolated deterministic test fixture\n        TrafficSecret::new(secret, CipherSuite::Aes128GcmSha256, epoch)\n    }\n\n    #[test]\n    fn direction_epoch_caps_and_checked_overflow() {\n        assert!(matches!(\n            SendingTraffic(at_epoch(MAX_SEND_EPOCH)).update(&AwsLcProvider),\n            Err(KeyScheduleError::EpochExhausted)\n        ));\n        let next = ReceivingTraffic(at_epoch(MAX_SEND_EPOCH))\n            .update(&AwsLcProvider)\n            .unwrap();\n        assert_eq!(next.epoch(), MAX_SEND_EPOCH + 1);\n        assert!(matches!(\n            ReceivingTraffic(at_epoch(u64::MAX)).update(&AwsLcProvider),\n            Err(KeyScheduleError::EpochExhausted)\n        ));\n        let last = ReceivingTraffic(at_epoch(u64::MAX - 1))\n            .update(&AwsLcProvider)\n            .unwrap();\n        assert_eq!(last.epoch(), u64::MAX);\n    }\n}\n"},{"id":9,"name":{"Local":"crates/tls-core/src/client_policy.rs"},"crate_name":"tls_core","contents":"//! Pure flight-order policy for the no-PSK, server-authenticated TLS client.\n//! `verified` is evidence supplied by the endpoint after parsing and checking\n//! the message. This guard performs no cryptographic or certificate verification.\n\n/// Phases: 0=ServerHello, 1=EncryptedExtensions, 2=Certificate,\n/// 3=CertificateVerify, 4=server Finished, 5=client Finished handoff,\n/// 6=Established, 7=Failed. Internal events: 253=validated HRR,\n/// 252=client Finished handed off, 255=fatal failure.\n///\n/// An accepted HRR leaves phase zero; the caller must atomically set `retried`.\n/// Rejection returns no successor, so the endpoint must enter its failure path.\npub fn client_phase_next(phase: u8, message: u8, verified: bool, retried: bool) -> Option<u8> {\n    if message == 255 {\n        Some(7)\n    } else if !verified {\n        None\n    } else if phase == 0 && message == 2 {\n        Some(1)\n    } else if phase == 0 && message == 253 && !retried {\n        Some(0)\n    } else if phase == 1 && message == 8 {\n        Some(2)\n    } else if phase == 2 && message == 11 {\n        Some(3)\n    } else if phase == 3 && message == 15 {\n        Some(4)\n    } else if phase == 4 && message == 20 {\n        Some(5)\n    } else if phase == 5 && message == 252 {\n        Some(6)\n    } else {\n        None\n    }\n}\n"},{"id":10,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"crates/tls-core/src/wire.rs"},"crate_name":"tls_core","contents":"//! Pure record-header codec (RFC 9846 §§5.1–5.2).\nuse crate::Error;\n\npub const HEADER_LEN: usize = 5;\npub const MAX_PLAINTEXT: usize = 16_384;\npub const MAX_CIPHERTEXT: usize = 16_640;\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum RecordKind {\n    Plaintext,\n    Ciphertext,\n}\n\n/// Caller-selected stricter wire-body limit; never above the protocol maximum.\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub struct Limits {\n    kind: RecordKind,\n    max_payload: usize,\n}\n\nimpl Limits {\n    pub fn new(kind: RecordKind, max_payload: usize) -> Result<Self, Error> {\n        let maximum = match kind {\n            RecordKind::Plaintext => MAX_PLAINTEXT,\n            RecordKind::Ciphertext => MAX_CIPHERTEXT,\n        };\n        if max_payload > maximum {\n            return Err(Error::InvalidLimit);\n        }\n        Ok(Self { kind, max_payload })\n    }\n\n    pub const fn max_payload(self) -> usize {\n        self.max_payload\n    }\n\n    pub const fn kind(self) -> RecordKind {\n        self.kind\n    }\n\n    pub const fn max_wire_size(self) -> usize {\n        HEADER_LEN + self.max_payload\n    }\n}\n\n/// This validates outer syntax only; it does not authorize record types in any\n/// handshake state, check alert values/CCS body, or validate an AEAD tag.\n/// A ciphertext header intentionally rejects CCS, which is not ciphertext. A\n/// future endpoint must dispatch and drop permitted unencrypted CCS before\n/// attempting ciphertext deprotection (RFC 9846 §5), checking its body and the\n/// handshake window in which it is permitted.\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub struct Header {\n    pub content_type: u8,\n    pub legacy_version: u16,\n    pub length: u16,\n}\n\nimpl Header {\n    pub fn validate(self, limits: Limits) -> Result<Self, Error> {\n        if usize::from(self.length) > limits.max_payload {\n            return Err(Error::RecordOverflow);\n        }\n        match limits.kind {\n            RecordKind::Plaintext => match self.content_type {\n                20 if self.length == 1 => {}\n                21 if self.length == 2 => {}\n                22 if self.length != 0 => {}\n                20..=22 => return Err(Error::InvalidLength),\n                _ => return Err(Error::UnexpectedType),\n            },\n            RecordKind::Ciphertext => {\n                if self.content_type != 23 {\n                    return Err(Error::UnexpectedType);\n                }\n                if self.legacy_version != 0x0303 {\n                    return Err(Error::InvalidVersion);\n                }\n                if self.length == 0 {\n                    return Err(Error::InvalidLength);\n                }\n            }\n        }\n        // RFC 9846: plaintext legacy_record_version is ignored on receive.\n        Ok(self)\n    }\n\n    /// Writers always emit 0x0303. Initial ClientHello compatibility 0x0301 is\n    /// intentionally not implemented in this first foundation.\n    pub fn write(self, limits: Limits, output: &mut [u8]) -> Result<usize, Error> {\n        let canonical = Self {\n            legacy_version: 0x0303,\n            ..self\n        };\n        canonical.validate(limits)?;\n        let output = output.get_mut(..HEADER_LEN).ok_or(Error::BufferTooSmall)?;\n        output[0] = canonical.content_type;\n        output[1..3].copy_from_slice(&canonical.legacy_version.to_be_bytes());\n        output[3..5].copy_from_slice(&canonical.length.to_be_bytes());\n        Ok(HEADER_LEN)\n    }\n}\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum Parse<T> {\n    /// Exact additional bytes required for the header or complete body.\n    Incomplete {\n        needed: usize,\n    },\n    Complete {\n        value: T,\n        consumed: usize,\n    },\n}\n\npub fn parse_header(input: &[u8], limits: Limits) -> Result<Parse<Header>, Error> {\n    let Some(bytes) = input.get(..HEADER_LEN) else {\n        return Ok(Parse::Incomplete {\n            needed: HEADER_LEN - input.len(),\n        });\n    };\n    let header = Header {\n        content_type: bytes[0],\n        legacy_version: u16::from_be_bytes([bytes[1], bytes[2]]),\n        length: u16::from_be_bytes([bytes[3], bytes[4]]),\n    }\n    .validate(limits)?;\n    Ok(Parse::Complete {\n        value: header,\n        consumed: HEADER_LEN,\n    })\n}\n\n/// Borrowed wire body, including ciphertext where applicable. This is never\n/// authenticated application plaintext.\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub struct Record<'a> {\n    pub header: Header,\n    pub payload: &'a [u8],\n}\n\npub fn parse_record(input: &[u8], limits: Limits) -> Result<Parse<Record<'_>>, Error> {\n    let header = match parse_header(input, limits)? {\n        Parse::Incomplete { needed } => return Ok(Parse::Incomplete { needed }),\n        Parse::Complete { value, .. } => value,\n    };\n    let total = HEADER_LEN + usize::from(header.length);\n    let Some(record) = input.get(..total) else {\n        return Ok(Parse::Incomplete {\n            needed: total - input.len(),\n        });\n    };\n    Ok(Parse::Complete {\n        value: Record {\n            header,\n            payload: &record[HEADER_LEN..],\n        },\n        consumed: total,\n    })\n}\n"}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0