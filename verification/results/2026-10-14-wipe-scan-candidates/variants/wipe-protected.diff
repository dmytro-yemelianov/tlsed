+/// Erase caller bytes with aligned u128 stores, as `Reassembler::drop` does.
+fn wipe(bytes: &mut [u8]) {
+    let (head, words, tail) = bytemuck::pod_align_to_mut::<u8, u128>(bytes);
+    head.zeroize();
+    words.zeroize();
+    tail.zeroize();
 }
 
